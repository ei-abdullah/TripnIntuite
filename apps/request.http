### Search for an accommodation
POST https://api.duffel.com/stays/search
Accept-Encoding: gzip
Accept: application/json
Duffel-Version: v2
Authorization: Bearer duffel_test_yxP33-kImoqD2cfpgmP4kOwoM0BwQD7Q-1ZJprQn19U
Content-Type: application/json

{
  "data": {
    "rooms": "1",
    "location": {
      "radius": "5",
      "geographic_coordinates": {
        "longitude": -0.1416,
        "latitude": 51.5071
      }
    },
    "check_out_date": "2023-12-07",
    "check_in_date": "2023-12-04",
    "guests": [
      {
        "type": "adult"
      },
      {
        "type": "adult"
      }
    ]
  }
}