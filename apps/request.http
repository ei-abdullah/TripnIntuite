### Searching for flights
POST https://api.duffel.com/air/offer_requests
Accept-Encoding: gzip
Accept: application/json
Duffel-Version: v2
Authorization: Bearer duffel_test_yxP33-kImoqD2cfpgmP4kOwoM0BwQD7Q-1ZJprQn19U
Content-Type: application/json

{
  "data": {
    "slices": [
      {
        "origin": "NYC",
        "destination": "ATL",
        "departure_date": "2026-06-21"
      },
      {
        "origin": "ATL",
        "destination": "NYC",
        "departure_date": "2026-07-21"
      }
    ],
    "passengers": [
      {
        "type": "adult"
      },
      {
        "type": "adult"
      },
      {
        "age": 1
      }
    ],
    "cabin_class": "business"
  }
}


